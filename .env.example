# Example configuration for the reconstruction code (recon/config.py).
# Copy to `.env` and adjust. Every variable can also be exported in the shell;
# the HPC job scripts in scripts/ do exactly that.

# <phantom>-<dataset>: phantom is gammex | ctp528 | spiral, dataset is ideal | realistic
SETUP=ctp528-ideal
N_PROJECTIONS=720
TARGET_DOSE=5.0
ACTUAL_DOSE=5.0
N_SIGMA=3.0
PIXEL_W=0.25
N_SLICES=3
SLICE_THICKNESS=1.0
N_THREADS=8

# Data locations
WORKDIR=${HOME}/Scratch/data/recon/${SETUP}/${TARGET_DOSE}mGy/${N_PROJECTIONS}proj
INPUT_DIR=${WORKDIR}/processed-3sigma/protons
MATRIX_DIR=${WORKDIR}/processed-3sigma/matrix-${PIXEL_W}mm
VECTOR_DIR=${WORKDIR}/processed-3sigma/b
FBP_DIR=${WORKDIR}/processed-3sigma/fbp
OUTPUT_DIR=${WORKDIR}/recon
WEPL_LUT_PATH=
REF_DIR=phantoms/xray_refs

# Root of the reconstruction output read by the analysis scripts (analysis/paths.py):
# ${RECON_DATA_DIR}/<setup>/<dose>mGy/<n_proj>proj/recon/
RECON_DATA_DIR=${HOME}/Scratch/data/recon

# Reconstruction
ITER_START=0
ITER_END=200
X_INIT=zero            # zero | fbp
REGULARISER=TV         # None | TV | dTV
ALPHA=1e-3
ETA=0.1                # dTV only
PROX_TOLERANCE=1e-7
PROX_MAX_LOOPS=2000
DUMP_MODULO=100
